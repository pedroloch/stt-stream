# Environment Variables - Whisper Stream Client
#
# Este arquivo contém variáveis de ambiente opcionais para o cliente.
# Copie para .env e ajuste os valores conforme necessário.
#
# Uso:
#   cp .env.example .env
#   # Edite .env com seus valores
#   bun start

# ============================================
# Servidor Whisper Stream
# ============================================

# URL do WebSocket do servidor Python
# Exemplos:
#   - Local: ws://localhost:9090/ws
#   - RunPod: ws://167.99.123.456:9090/ws
#   - Produção: wss://whisper.seu-dominio.com/ws
WHISPER_SERVER_URL=ws://localhost:9090/ws

# URL do health check endpoint
# Usado para verificar se servidor está online antes de conectar
WHISPER_HEALTH_URL=http://localhost:9090/health

# ============================================
# Áudio (Opcional)
# ============================================

# Taxa de amostragem em Hz (padrão: 16000)
# WHISPER_SAMPLE_RATE=16000

# Número de canais (padrão: 1 para mono)
# WHISPER_CHANNELS=1

# ============================================
# Display (Opcional)
# ============================================

# Mostrar transcrições parciais? (true/false)
# WHISPER_SHOW_PARTIAL=false

# Mostrar timestamps? (true/false)
# WHISPER_SHOW_TIMESTAMPS=true

# ============================================
# Autenticação (Se servidor requer)
# ============================================

# API Key ou Bearer Token (se servidor tem auth habilitado)
# WHISPER_API_KEY=seu-token-secreto-aqui

# ============================================
# Debug (Opcional)
# ============================================

# Modo debug - mostra JSON completo das mensagens WebSocket
# Útil para entender o que o servidor está mandando
# DEBUG=1 bun start   # Ativa debug via env
# WHISPER_DEBUG=1     # Ou configure aqui
WHISPER_DEBUG=0

# Modo verbose (logs detalhados)
# WHISPER_VERBOSE=false

# Salvar áudio enviado para debug
# WHISPER_SAVE_AUDIO=false

# ============================================
# Notas
# ============================================
#
# 1. Variáveis de ambiente têm prioridade sobre config.yaml
# 2. Se .env não existir, usa valores de config.yaml
# 3. Nunca commite .env no git! (.env está no .gitignore)
# 4. Para RunPod: troque apenas WHISPER_SERVER_URL e WHISPER_HEALTH_URL
