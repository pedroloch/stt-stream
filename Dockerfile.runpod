# Dockerfile otimizado para RunPod com CUDA
# Usa modelo large-v3 para melhor qualidade de transcrição
#
# Build: docker build -f Dockerfile.runpod -t whisper-stream-runpod .
# Run:   docker run --gpus all -p 9090:9090 whisper-stream-runpod

FROM nvidia/cuda:12.1.0-base-ubuntu22.04

# Evitar prompts interativos
ENV DEBIAN_FRONTEND=noninteractive

# Instalar Python 3.10 e dependências do sistema
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    python3.10-venv \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Criar symlinks para python
RUN ln -sf /usr/bin/python3.10 /usr/bin/python && \
    ln -sf /usr/bin/python3.10 /usr/bin/python3

# Atualizar pip
RUN python -m pip install --upgrade pip

# Instalar uv para gerenciamento de pacotes rápido
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.cargo/bin:${PATH}"

# Definir diretório de trabalho
WORKDIR /app

# Copiar apenas arquivos necessários primeiro (cache de camadas)
COPY pyproject.toml ./
COPY server/ ./server/

# Instalar dependências Python com CUDA
# faster-whisper com suporte CUDA
RUN pip install --no-cache-dir \
    aiohttp==3.9.0 \
    aiohttp-cors==0.7.0 \
    numpy==1.26.0 \
    pyyaml==6.0 \
    faster-whisper==1.0.3 \
    torch --index-url https://download.pytorch.org/whl/cu121

# Copiar configuração de produção
COPY server-config.runpod.yaml ./server-config.yaml

# Criar diretórios para modelos e logs
RUN mkdir -p /app/models /app/logs /app/cache

# Variáveis de ambiente
ENV PYTHONUNBUFFERED=1
ENV CUDA_VISIBLE_DEVICES=0
ENV HF_HOME=/app/cache

# Expor porta WebSocket
EXPOSE 9090

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:9090/health')" || exit 1

# Comando para iniciar servidor
# Modelo large-v3 será baixado automaticamente no primeiro uso (~3GB)
CMD ["python", "-m", "server.main", "--config", "server-config.yaml", "--verbose"]
