{
  // Python Environment - Poetry + Pyenv (3.12)
  // Usa Poetry como único interpreter, sem descoberta automática
  "python.defaultInterpreterPath": "/Users/pedro/Library/Caches/pypoetry/virtualenvs/whisper-stream-server-am06cuK3-py3.12/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.terminal.executeInFileDir": true,
  "python.linting.enabled": true,

  // Disable automatic interpreter discovery (only use Poetry)
  "python.venvPath": "",
  "python.condaPath": "",
  "python.pipenvPath": "",
  "python.pyenvPath": "",

  // Formatting
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "python.formatting.provider": "none",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },

  // Linting - Ruff (replaces flake8, isort, etc)
  "ruff.enable": true,
  "ruff.organizeImports": true,
  "ruff.fixAll": true,
  "ruff.lint.run": "onSave",

  // Type Checking - Pyright (configured in pyproject.toml)
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.variableTypes": true,

  // Testing
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "tests"
  ],

  // File Associations
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true,
    "**/pyrightconfig.json": false
  },

  // Editor
  "editor.rulers": [88, 120],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // Ruff configuration
  "ruff.lineLength": 100
}
